# Copy to .env.local and fill in. See SETUP.md for where each value comes from.
# .env.local is gitignored — never commit real values.

MONGODB_URI=
GEMINI_API_KEY=
# Optional extra keys from SEPARATE Google projects. Each has its own daily
# quota, and embed.ts moves to the next when one returns 429. Up to _5.
GEMINI_API_KEY_2=
GROQ_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
